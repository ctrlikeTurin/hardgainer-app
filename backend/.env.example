# Local dev uses SQLite. For Supabase Postgres use:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./hardgainer.db

# Supabase project URL (tokens are verified against its public JWKS).
SUPABASE_URL=https://<project>.supabase.co
# Only set this if your project still uses the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: route Gemini through Cloudflare AI Gateway (caching, retries, analytics).
# Create the gateway in the dashboard (AI > AI Gateway) if "default" doesn't exist yet. Leave blank to call Google directly.
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/79ee3e1f35f72bb0a0ee0581a6db9ad5/default/google-ai-studio

# Models are tried in order; on 429/5xx the next one is used.
VISION_MODELS=["gemini-3.5-flash","gemini-3.5-flash-lite","gemini-3.1-flash-lite"]
TEXT_MODELS=["gemini-3.5-flash-lite","gemini-3.1-flash-lite","gemini-3.5-flash"]

FRONTEND_ORIGINS=["http://localhost:5173"]
FOOD_SCANS_PER_MINUTE=5
CHECKIN_MIN_DAYS=6
